# Copy to .env and edit.  python run.py reads this file.

# simulated = built-in simulator (default) | cloud = devices POST over HTTP
# serial = ESP32 over USB | mqtt = ESP32 over MQTT
MODE=cloud
HOST=0.0.0.0
PORT=8000

# --- cloud HTTP ingest (devices -> POST /api/ingest) ---
ALLOW_INGEST=true
# Optional shared secret. If set, devices must send header X-Device-Token: <this>.
INGEST_TOKEN=

# --- identity used when the device does not send one ---
PATIENT_ID=P-REAL-01
PATIENT_NAME=Patient
DEVICE_ID=ESP32-01

# --- emergency notifier ---------------------------------------------------
# Leave the three TWILIO_* blank to run in SIMULATED mode: alert messages are
# written to data/notifications.log and shown on the dashboard, but NOT sent.
# To send real SMS/calls, create a Twilio account and fill these in:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Let the simulator's abnormal episodes also trigger (simulated) alerts, for demos:
NOTIFY_ON_SIMULATED=false

# --- real mode: USB serial / MQTT (only if MODE=serial|mqtt) ---
SERIAL_PORT=auto
SERIAL_BAUD=115200
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_PREFIX=healthmon

# --- ECG scaling (AD8232 gain ~1100, centred at ~1.65 V on 3.3 V) ---
ECG_SAMPLE_RATE=250
ADC_VREF=3.3
ADC_MIDPOINT_V=1.65
ECG_GAIN=1100

# --- processing ---
READING_INTERVAL_S=1.0
ECG_WINDOW_S=8
STALE_AFTER_S=3

# --- files (relative to project root) ---
RESULTS_CSV=data/results.csv
SIMULATED_CSV=data/live_simulated.csv
REAL_CSV=data/live_real.csv
THRESHOLDS_FILE=config/thresholds.json
PATIENTS_FILE=config/patients.json
NOTIFICATIONS_LOG=data/notifications.log

# --- simulator (MODE=simulated only) ---
SIM_SCENARIO=demo
SIM_PATIENTS=3
LOG_LEVEL=INFO
